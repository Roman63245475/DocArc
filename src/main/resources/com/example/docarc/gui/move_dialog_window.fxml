<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="540.0" prefWidth="600.0" spacing="15.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.docarc.gui.MoveFileController">
   <children>
      <Label text="Move file to other document">
         <VBox.margin>
            <Insets top="30.0" />
         </VBox.margin>
      </Label>
      <ComboBox fx:id="boxCombobox" prefWidth="150.0" promptText="Select Box">
         <VBox.margin>
            <Insets />
         </VBox.margin>
      </ComboBox>
      <ComboBox fx:id="docCombobox" prefWidth="150.0" promptText="Select Document" />
      <Label text="Files of the selected Document, file that you've selected to move, is at the bottom" />
      <ListView fx:id="filesListView" maxWidth="-Infinity" prefHeight="294.0" prefWidth="400.0" />
      <HBox alignment="CENTER" minWidth="-Infinity" prefHeight="40.0" prefWidth="600.0" spacing="100.0">
         <children>
            <Button mnemonicParsing="false" onAction="#onCancel" text="Cancel" />
            <Button mnemonicParsing="false" onAction="#onSave" text="Save" />
         </children>
      </HBox>
   </children>
</VBox>
